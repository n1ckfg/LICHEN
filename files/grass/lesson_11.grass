PRINT NB

SAM=[a=10
b=20
PRINT SQUAREM(?a,?b)]
SQUAREM=[INPUT a,b
RETURN a*a+b*b]

CHANGE=[$L0=$L0+$X1*8
$L1=$L1+$Y1*8
$L2=$K1]
CHANGE.B
NB.B

TIMEDBOX=[TIMEOUT 300
BOX 0,0,200,200,7]
COMPILE TIMEDBOX,CTIME
CTIME.F

UGH=[ARRAY SAM,10
A=-1
ONERROR 1OUT
PR SAM(A=A+1);SKIP 0
1OUT PRINT "SAM OUT OF BOUNDS"]
