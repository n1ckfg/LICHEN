PRINT "HELLO!"

PRINT [HELLO!]

A=[HELLO!]

PRINT A,A,A,A,A

PRINT A&A&A&A&A

Q=[BOX 0,0,100,100,2
BOX 50,50,100,100,3]

P=100
PRINT P
P P
P P 10

QUANTIZED$SECOND$DEGREE$SPACE$INVADERS=[BOX 0,0,100,100,3]

MYBO=BO

ABC=10
DEF=[STRINGYTHINGY]
USEMAP

DEL ABC
USEMAP

MANYBOXES=[CLEAR
A=300
10 A=A-3
IF A>0,BOX 0,0,A,A,A\4;GOTO 10]

RANDOMCROSSES=[CLEAR
1MORE X=-160%159
Y=-100%100
LINE X-10,Y,4
LINE X+10,Y,3
LINE X,Y-10,4
LINE X,Y+10,3
GOTO 1MORE]
