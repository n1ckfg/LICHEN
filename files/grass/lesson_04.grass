. LESSON 4 MORE ON MACROS
. In these examples color 1 is teal, not red. $L1 says which of the
. palette's 256 colors color 1 shows (lesson 7); 29 is teal, and
. $L1=1 makes it red again.
$L1=29
. Labels, GOTO, IF, SKIP, SIN and COS, INPUT and PROMPT, COMPILE.
TRIANGLES=[CLEAR
PRINT "LOOK AT THE TV!"
SIZE=0
1UP SIZE=SIZE+2
LINE 0,SIZE*2,4
LINE -SIZE,-SIZE,1
LINE SIZE,-SIZE,2
LINE 0,SIZE*2,3
IF SIZE<50,GOTO 1UP]

COMPILE TRIANGLES,CT

. The lesson also shows IF (SIZE=SIZE+2)<50,GOTO 1UP as a shorter way
. to write the last line of TRIANGLES.

COUNTDOWN=[A=10
1LESS PRINT A
A=A-1
IF A==5,PR "HALFWAY THERE"
IF A>0,GOTO 1LESS
PRINT "BLASTOFF"]

PRINT 5==5
PRINT 5==6

. LINE with colormode 4 moves the pen without drawing.
SWEEP=[ANGLE=0
CLEAR
X=SIN(ANGLE)*150
Y=COS(ANGLE)*75
LINE X,Y,4
LINE -X,-Y,1%4
IF (ANGLE=ANGLE+2)<180,SKIP -4]

. INPUT takes the macro's arguments, or waits for you to type them.
HOWMANYBOXES=[CLEAR
PROMPT "NUMBER OF BOXES TO DRAW?"
INPUT QUAN
XCENTER=-160
BOX XCENTER=XCENTER+20,0,18,18,3
IF (QUAN=QUAN-1)>0,SKIP -1]

GRIDBOXES=[CLEAR
PROMPT "NUMBER OF BOXES TO DRAW?"
INPUT QUAN
YCENTER=80
XCENTER=-160
BOX XCENTER=XCENTER+20,YCENTER,18,18,3
IF (QUAN=QUAN-1)==0,RETURN
IF XCENTER==140,YCENTER=YCENTER-20;SKIP -3
SKIP -3]

GRIDBOXES 30

SINECURVE=[PROMPT "WHAT'S THE OFFSET TO BE?"
INPUT OFFSET
X=-160
ANGLE=0
POINT OFFSET+X,SIN(ANGLE)*80,3
ANGLE=ANGLE+2
IF (X=X+1)<159,SKIP -2]

SINECURVE 0
SINECURVE 30

. Typed by itself, MANYSINES asks for its three numbers. Try it, or
. MANYSINES 0,100,5
MANYSINES=[PROMPT "FIRST OFFSET?"
PROMPT "LAST OFFSET?"
PROMPT "HOW MANY?"
INPUT FIRST,LAST,QUAN
INCREMENT=(LAST-FIRST)/QUAN
SINECURVE FIRST
IF (FIRST=FIRST+INCREMENT)<=LAST,SKIP -1]

COMPILE SINECURVE,FASTSINE

NAMES=[PROMPT "WHAT'S YOUR NAME?"
INP.STR XXXX
PRINT "THAT'S FUNNY!, ",XXXX," IS MY NAME TOO!"]

. THE ANIMATION. RADAR is SWEEP going round and round. Each half turn
. paints its lines in the next color over the last half turn's, so it
. never needs to CLEAR. Press ESC to stop it.
RADAR=[CLEAR;ANGLE=0;C=1
X=SIN(ANGLE)*150;Y=COS(ANGLE)*96
LINE X,Y,4;LINE -X,-Y,C
IF (ANGLE=ANGLE+1)<180,SKIP -2
ANGLE=0;C=C\3+1;SKIP -3]
RADAR
